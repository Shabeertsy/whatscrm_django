# ── Evolution API & Manager Ports ──────────────────────────────
EVOLUTION_PORT=8080
EVOLUTION_MANAGER_PORT=3000

# ── Evolution API Server Config ────────────────────────────────
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
AUTHENTICATION_API_KEY=evolution_secret_key_change_me_123

# ── PostgreSQL Database Credentials ────────────────────────────
POSTGRES_DATABASE=evolution_db
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=evolution_secret_password
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_secret_password@evolution-postgres:5432/evolution_db?schema=public
DATABASE_CLIENT_NAME=evolution_db

# ── Redis Cache & Queue ────────────────────────────────────────
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false

# ── WhatsApp Session Storage ───────────────────────────────────
DEL_INSTANCE=false
STORE_MESSAGES=true
STORE_MESSAGE_UP=true
STORE_CONTACTS=true
STORE_CHATS=true

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS
QRCODE_LIMIT=30

